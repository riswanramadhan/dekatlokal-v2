NEXT_PUBLIC_MAIN_SITE_URL=https://dekatlokal.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DATA_SOURCE=mock
DATA_SOURCE=mock
NEXT_PUBLIC_DEMO_SCENARIO=culinary-new-user

# Future server-only variables
DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=

# Future integrations
BLOB_READ_WRITE_TOKEN=
WHATSAPP_PROVIDER_TOKEN=
ANALYTICS_WRITE_KEY=

# Ruang ahli (/ahli) — kode akses pribadi per ahli. HANYA di server (Vercel env), jangan pakai prefix NEXT_PUBLIC.
# Kode dibandingkan dalam waktu konstan (HMAC + timingSafeEqual) dan tidak pernah dikirim ke browser.
# Format A (disarankan) — JSON satu baris, kunci = assignmentId pada lib/digital-checkup/expert-directory.ts,
# nilai = kode acak 12–64 karakter yang BERBEDA untuk tiap ahli. Contoh bentuk (placeholder tidak valid):
#   DC_EXPERT_ACCESS_CODES={"723c62f6-af29-43b8-8e9a-32d8923d0f0e":"<kode-1>","54938064-c676-46a0-aad3-a43c2f49cb05":"<kode-2>","6370bdf5-7e63-45e7-b2b7-c4a6e2f171c3":"<kode-3>"}
# Format B — roster lengkap yang menggantikan direktori (tepat tiga penugasan):
#   DC_EXPERT_ROSTER=[{"name":"...","assignmentId":"UUID","accessCode":"<kode>"},...]
# Buat kode: node -e "console.log(require('node:crypto').randomBytes(12).toString('base64url'))"
# Tanpa kode, /ahli tertutup kecuali DC_EXPERT_ALLOW_PUBLIC_ENTRY=true (hanya untuk demo lokal).
# Sesi ahli memakai cookie bertanda tangan HMAC 8 jam; DC_EXPERT_SESSION_SECRET minimal 32 karakter.
DC_EXPERT_ACCESS_CODES=
DC_EXPERT_ROSTER=
DC_EXPERT_SESSION_SECRET=
DC_EXPERT_ALLOW_PUBLIC_ENTRY=false

# AI Admin website UMKM (Gemini, hanya server). GEMINI_MODEL boleh daftar dipisah koma.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash,gemini-2.5-flash-lite
