q-toggle"}]],["P",{"class":"dl-faq-answer"},"Bisa banget. Materinya dibagi jadi langkah-langkah kecil, dengan contoh yang dekat dengan kegiatan jualan sehari-hari. Kamu bisa belajar pelan-pelan."]],["DETAILS",{"class":"dl-faq-item dl-faq-reference-item"},["SUMMARY",{"aria-expanded":"false"},["SPAN",{},"Apakah hasil Checkup langsung membuat saya dapat website gratis?"],["I",{"aria-hidden":"true","class":"dl-faq-toggle"}]],["P",{"class":"dl-faq-answer"},"Belum tentu. Website gratis mengikuti syarat dan kuota program. Mengisi Digital Checkup saja belum menjamin kamu mendapatkannya."]],["DETAILS",{"class":"dl-faq-item dl-faq-reference-item"},["SUMMARY",{"aria-expanded":"false"},["SPAN",{},"Untuk apa data usaha saya dipakai?"],["I",{"aria-hidden":"true","class":"dl-faq-toggle"}]],["P",{"class":"dl-faq-answer"},"Jawabanmu dipakai untuk menyusun hasil Digital Checkup dan saran belajar. Baca Kebijakan Privasi di bagian bawah halaman untuk tahu lebih lengkap tentang penggunaan data."]]]]]]],["SECTION",{"aria-labelledby":"start-title","class":"dl-final-cta dl-viewport-section","id":"mulai"},["DIV",{"aria-hidden":"true","class":"dl-cta-grid"}],["DIV",{"class":"dl-final-inner"},["DIV",{"class":"dl-final-copy","data-reveal-item":"true"},["P",{"class":"dl-section-kicker"},"Langkah kecil, mulai hari ini"],["H2",{"id":"start-title"},"Usahamu punya peluang. Yuk, cari langkah berikutnya."],["P",{},"Luangkan 5–7 menit untuk cek usahamu. Lihat yang perlu dibenahi, lalu mulai dari yang paling mudah."],["DIV",{},["A",{"class":"dl-final-primary","href":"/mulai"},"Cek Usahaku Sekarang ",["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"18","height":"18","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-arrow-up-right","aria-hidden":"true"},["path",{"d":"M7 7h10v10"}],["path",{"d":"M7 17 17 7"}]]]]],["DIV",{"aria-hidden":"true","class":"dl-final-visual","data-reveal-item":"true"},["IMG