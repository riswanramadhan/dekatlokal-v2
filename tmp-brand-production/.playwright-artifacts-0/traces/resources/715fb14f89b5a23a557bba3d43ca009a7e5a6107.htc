c:["$","section",null,{"aria-labelledby":"experience-title","className":"dl-testimonials-section dl-viewport-section","id":"pengalaman","children":[["$","div",null,{"className":"dl-story-heading","data-reveal-item":true,"children":[["$","div",null,{"children":[["$","p",null,{"className":"dl-section-kicker","children":"Cerita perjalanan UMKM"}],["$","h2",null,{"id":"experience-title","children":["Bukan soal langsung besar. ",["$","span",null,{"className":"dl-title-pill","children":"Soal terus bergerak."}]]}]]}],["$","p",null,{"children":"Kenalan dengan usaha lokal yang terus belajar, merapikan jualan, dan mencoba hal baru."}]]}],["$","$L26",null,{"stories":[{"id":"bio","business":"Bio Atama","category":"Produk alami","summary":"Produk bagus butuh pesan yang gampang dipahami. Bio Atama merapikan cara menjelaskan manfaat produknya supaya calon pelanggan tidak perlu menebak.","image":"/platform-v2/stories/latest/bio-atama.webp","imageAlt":"Tim Bio Atama menunjukkan perkembangan tampilan online usahanya","logo":"/umkm/bio-atama.webp"},{"id":"eyfa","business":"Eyfa Natural Oil","category":"Perawatan alami","summary":"Identitas yang konsisten bikin produk lebih mudah dikenali. Eyfa mulai dari tampilan sederhana yang bisa dipakai di setiap tempat jualan.","image":"/platform-v2/stories/latest/eyfa-natural-oil.webp","imageAlt":"Tim Eyfa Natural Oil dalam perjalanan pengembangan usaha","logo":"/umkm/eyfa-natural-oil.webp"},{"id":"gingerfit","business":"Gingerfit Plus","category":"Minuman herbal","summary":"Bertumbuh tidak harus serba sekaligus. Gingerfit memilih prioritas yang paling dekat, mengerjakannya, lalu lanjut ke langkah berikutnya.","image":"/platform-v2/stories/latest/gingerfit-plus.webp","imageAlt":"Tim Gingerfit Plus menunjukkan perkembangan usaha","logo":"/umkm/gingerfit-plus.webp"},{"id":"iboo","business":"Iboo IDN","category":"Produk lokal","summary":"Saat rencana usaha lebih jelas, bikin konten dan mengambil keputusan terasa lebih ringan. Iboo IDN memulai dari hal yang paling berdampak.","image":"/platform-v2/stories/latest/iboo-idn.webp","imageAlt":"Tim Iboo IDN dalam perjalanan pengembangan usaha","logo":"/umkm/iboo-idn.webp"},{"id":"kareppe","business":"Kareppe","category":"Kuliner","summary":"Cerita produk yang kuat membuat orang lebih mudah ingat. Kareppe menyusun tampilan online agar karakter produknya tetap terasa di layar.","image":"/platform-v2/stories/latest/kareppe.webp","imageAlt":"Tim Kareppe dalam perjalanan pengembangan usaha","logo":"/umkm/logo-kareppe-transparent.webp"},{"id":"michi","business":"Kira Kira Michi","category":"Kuliner kreatif","summary":"Ide kreatif jadi lebih kuat saat tampilannya konsisten. Kira Kira Michi menyatukan identitas, konten, dan pengalaman pelanggan.","image":"/platform-v2/stories/latest/kira-kira-michi.webp","imageAlt":"Tim Kira Kira Michi menunjukkan perkembangan usaha","logo":"/umkm/kira-kira-michi.webp"},{"id":"kopi","business":"Kopi Teko","category":"Kopi lokal","summary":"Kopi Teko merapikan informasi produk dan cara pemesanan agar pelanggan bisa menemukan, memahami, lalu membeli dengan lebih mudah.","image":"/platform-v2/stories/latest/kopi-teko.webp","imageAlt":"Tim Kopi Teko dalam perjalanan pengembangan usaha","logo":"/umkm/kopi-teko.webp"},{"id":"pamboang","business":"Minyak Pamboang","category":"Produk tradisional","summary":"Produk lokal punya cerita yang layak dikenal lebih luas. Minyak Pamboang membawanya ke ruang digital dengan langkah yang bisa dikerjakan satu per satu.","image":"/platform-v2/stories/latest/minyak-pamboang.webp","imageAlt":"Tim Minyak Pamboang menunjukkan perkembangan tampilan online","logo":"/umkm/minyak-pamboang.webp"},{"id":"mulkan","business":"Mulkan Mimbaun","category":"Produk lokal","summary":"Mulkan Mimbaun mengubah target besar menjadi langkah kecil yang jelas. Jadi lebih mudah dimulai dan dilanjutkan.","image":"/platform-v2/stories/latest/mulkan-mimbaun.webp","imageAlt":"Tim Mulkan Mimbaun dalam perjalanan pengembangan usaha","logo":"/umkm/mulkan-mimbaun.webp"},{"id":"keripik","business":"Rumah Keripik","category":"Camilan","summary":"Rumah Keripik mulai dari informasi produk yang rapi, supaya promosi tidak cuma ramai sesaat tetapi benar-benar membantu penjualan.","image":"/platform-v2/stories/latest/rumah-keripik.webp","imageAlt":"Tim Rumah Keripik menunjukkan perkembangan usahanya","logo":"/umkm/rumah-keripik.webp"}]}]]}]
