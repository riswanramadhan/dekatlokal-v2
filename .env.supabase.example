# Copy into .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=https://digitalcheckup.dekatlokal.com
DC_BUILD_ID=
# Random secret of at least 32 characters; server and scheduler only.
CRON_SECRET=
# Expert room (/ahli): one private access code per expert. Server-only; never prefix with NEXT_PUBLIC.
# Format: see env.example (DC_EXPERT_ACCESS_CODES JSON keyed by assignmentId, or a full DC_EXPERT_ROSTER).
# Without codes /ahli stays closed unless DC_EXPERT_ALLOW_PUBLIC_ENTRY=true (local demo only).
DC_EXPERT_ACCESS_CODES=
DC_EXPERT_ROSTER=
DC_EXPERT_SESSION_SECRET=
DC_EXPERT_ALLOW_PUBLIC_ENTRY=false
# Optional fixed model version and approving admin/researcher UUID.
# If both are blank, the server uses the matching latest unfrozen version and
# an existing admin/researcher profile after exactly three roster experts are final.
DC_AUTO_MODEL_VERSION=
DC_AUTO_MODEL_APPROVER=
# Only for the development admin seed; remove password after seeding.
DC_SEED_ENV=development
DC_ADMIN_EMAIL=admin@dekatlokal.com
DC_ADMIN_PASSWORD=
# Inbox milik developer/penguji yang benar-benar dapat menerima OTP.
# Hanya dipakai sekali oleh npm run db:provision:demo-user; jangan commit alamat asli.
DC_DEMO_USER_EMAIL=
DC_DEMO_USER_NAME=User Demo DekatLokal
