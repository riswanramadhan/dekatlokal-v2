# Copy into .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=https://digitalcheckup.dekatlokal.com
DC_BUILD_ID=
# Random secret of at least 32 characters; server and scheduler only.
CRON_SECRET=
# Exactly three existing expert assignments: [{"name":"...","assignmentId":"UUID","accessCode":"random-12+-characters"}, ...]
# Leave blank to use the owner-approved Ayu / Asluddin / Rizky directory (name-only entry).
# Never prefix these settings with NEXT_PUBLIC.
DC_EXPERT_ROSTER=
DC_EXPERT_SESSION_SECRET=
DC_EXPERT_ALLOW_PUBLIC_ENTRY=false
# Optional fixed model version and approving admin/researcher UUID.
# If both are blank, the server uses the matching latest unfrozen version and
# an existing admin/researcher profile after exactly three roster experts are final.
DC_AUTO_MODEL_VERSION=
DC_AUTO_MODEL_APPROVER=
# Only for the development admin seed; remove password after seeding.
DC_SEED_ENV=development
DC_ADMIN_EMAIL=admin@dekatlokal.com
DC_ADMIN_PASSWORD=
